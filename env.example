# Copy to `.env` before running:  cp .env.example .env

# Makes files Airflow writes (logs/) owned by you rather than root.
# On Linux/macOS run:  echo "AIRFLOW_UID=$(id -u)" >> .env
AIRFLOW_UID=50000

# GID of the docker socket, so the Airflow scheduler can launch Spark containers.
#   Linux:  set to  `stat -c '%g' /var/run/docker.sock`  (often 999 or 998)
#   Docker Desktop (macOS/Windows): 999 is fine, leave as-is.
DOCKER_GID=999

# Copy to `.env` before running:  cp env.example .env

# LINUX ONLY: makes files Airflow writes (logs/) owned by you rather than root.
#   echo "AIRFLOW_UID=$(id -u)" >> .env
# On macOS/Docker Desktop leave this at 50000. A host uid has no entry in the
# image's /etc/passwd, and airflow-init overrides the entrypoint that would
# register it, so init fails with "getpwuid(): uid not found".
AIRFLOW_UID=50000

# GID of the docker socket, so the Airflow scheduler can launch Spark containers.
#   Linux:  set to  `stat -c '%g' /var/run/docker.sock`  (often 999 or 998)
#   Docker Desktop (macOS/Windows): 999 is fine, leave as-is.
DOCKER_GID=999
